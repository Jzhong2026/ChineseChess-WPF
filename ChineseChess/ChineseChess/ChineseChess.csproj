  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Caliburn.Micro" Version="5.0.258" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\artifacts\cnn_policy_value.onnx" Link="cnn_policy_value.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
