<UserControl x:Class="ChineseChess.Views.SidePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#AAFFFCF1" />
            <Setter Property="BorderBrush" Value="#3353402F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#38483629" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#B8FFFCF1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Xiangqi Offline AI"
                       Foreground="#2C6662"
                       FontSize="12"
                       FontWeight="ExtraBold" />
            <TextBlock Text="中国象棋人机版"
                       Foreground="#221A16"
                       FontSize="38"
                       FontWeight="Bold"
                       Margin="0,4,0,18" />

            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="13"
                                 Height="13"
                                 Margin="0,4,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#202020" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRedTurn}" Value="True">
                                            <Setter Property="Fill" Value="#B42322" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="19"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}"
                               Foreground="#6A594D"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding RuleNotice}"
                               Foreground="#A3332A"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="执棋"
                       Foreground="#5F5148"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />
            <UniformGrid Columns="2" Margin="0,0,0,14">
                <Button Content="红方"
                        cal:Message.Attach="[Event Click] = [Action ChooseRed]">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHumanRed}" Value="True">
                                    <Setter Property="Background" Value="#2B6864" />
                                    <Setter Property="Foreground" Value="#FFFAF0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="黑方"
                        cal:Message.Attach="[Event Click] = [Action ChooseBlack]">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHumanBlack}" Value="True">
                                    <Setter Property="Background" Value="#2B6864" />
                                    <Setter Property="Foreground" Value="#FFFAF0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <TextBlock Text="难度"
                       Foreground="#5F5148"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Button Content="简单" cal:Message.Attach="[Event Click] = [Action ChooseLevel1]">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLevel1}" Value="True">
                                    <Setter Property="Background" Value="#2B6864" />
                                    <Setter Property="Foreground" Value="#FFFAF0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="基础" cal:Message.Attach="[Event Click] = [Action ChooseLevel2]">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLevel2}" Value="True">
                                    <Setter Property="Background" Value="#2B6864" />
                                    <Setter Property="Foreground" Value="#FFFAF0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="中等" cal:Message.Attach="[Event Click] = [Action ChooseLevel3]">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLevel3}" Value="True">
                                    <Setter Property="Background" Value="#2B6864" />
                                    <Setter Property="Foreground" Value="#FFFAF0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="困难" cal:Message.Attach="[Event Click] = [Action ChooseLevel4]">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLevel4}" Value="True">
                                    <Setter Property="Background" Value="#2B6864" />
                                    <Setter Property="Foreground" Value="#FFFAF0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <TextBlock Text="{Binding AiTimeLimitMs, StringFormat=AI 思考时间：{0} ms}"
                       Foreground="#5F5148"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />
            <Slider Minimum="300"
                    Maximum="4000"
                    TickFrequency="100"
                    IsSnapToTickEnabled="True"
                    Value="{Binding AiTimeLimitMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,16" />

            <Border Style="{StaticResource PanelCardStyle}"
                    Visibility="{Binding HasSearchStats, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SearchStats" FontWeight="Bold" Grid.ColumnSpan="2" Margin="0,0,0,8" />
                    <TextBlock Text="深度" Grid.Row="1" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchDepthText}" Grid.Row="1" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SearchNodesText}" Grid.Row="2" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchTimeText}" Grid.Row="2" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="Score" Grid.Row="3" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchScoreText}" Grid.Row="3" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="TT hits" Grid.Row="4" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchTtHitsText}" Grid.Row="4" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="TT stores" Grid.Row="5" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchTtStoresText}" Grid.Row="5" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="TT move hits" Grid.Row="6" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchTtBestMoveHitsText}" Grid.Row="6" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="TT score hits" Grid.Row="7" Foreground="#7A6658" />
                    <TextBlock Text="{Binding SearchTtScoreHitsText}" Grid.Row="7" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,14">
                <Button Content="重开"
                        Background="#A3332A"
                        Foreground="#FFFAF0"
                        Style="{StaticResource ActionButtonStyle}"
                        cal:Message.Attach="[Event Click] = [Action Restart]" />
                <Button Content="悔棋"
                        Style="{StaticResource ActionButtonStyle}"
                        cal:Message.Attach="[Event Click] = [Action Undo]" />
            </UniformGrid>

            <Border Style="{StaticResource PanelCardStyle}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12">
                        <TextBlock Text="棋谱"
                                   FontWeight="Bold"
                                   Foreground="#5F5148" />
                        <TextBlock Text="{Binding History.Count, StringFormat={}{0} 手}"
                                   HorizontalAlignment="Right"
                                   Foreground="#5F5148"
                                   FontWeight="Bold" />
                    </Grid>
                    <ListBox ItemsSource="{Binding History}"
                             MaxHeight="300"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="#7A6658" />
                                    <TextBlock Text="{Binding Text}" Grid.Column="1" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
